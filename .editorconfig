root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# Стиль intellij_idea, а не ktlint_official: последний требует переносить
# многострочное выражение на строку ниже присваивания, и вёрстка Compose
# от этого разъезжается.
ktlint_code_style = intellij_idea
indent_style = space
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composable-функции называются с заглавной буквы — это не нарушение.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,yml,yaml,toml}]
indent_style = space
indent_size = 2
